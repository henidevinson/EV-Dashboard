# Telemetry Source Mode: disconnected | serial | can | mock (mock is ONLY allowed in Phase 4)
TELEMETRY_MODE=disconnected

# Serial Interface Settings (Current Test Configuration: subject to change)
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT_SECONDS=1.0

# CAN Interface Settings (Pending hardware identification)
CAN_INTERFACE=socketcan
CAN_CHANNEL=can0
CAN_BITRATE=

# Telemetry Health Rules
TELEMETRY_FRESHNESS_TIMEOUT=5.0

# Battery Calibration Offset (Volts)
VOLTAGE_OFFSET=0.0

# Database Configuration
DATABASE_URL=sqlite:///./ev_telemetry.db

# API Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false